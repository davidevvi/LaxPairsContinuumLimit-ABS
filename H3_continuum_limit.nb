6047fd536522"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Derivative", "[", "inds__", "]"}], "[", "u", "]"}], "[", "___", 
    "]"}], "/;", 
   RowBox[{"AnyTrue", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Thread", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"Length", "[", 
          RowBox[{"{", "inds", "}"}], "]"}], "]"}], ",", 
        RowBox[{"{", "inds", "}"}]}], "}"}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"EvenQ", "[", 
        RowBox[{"First", "[", "#", "]"}], "]"}], "&&", 
       RowBox[{
        RowBox[{"Last", "[", "#", "]"}], ">", "0"}]}], "&"}]}], 
    "\[IndentingNewLine]", "]"}]}], ":=", "0"}]], "Input",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},

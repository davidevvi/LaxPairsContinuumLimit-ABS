Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{
  "u", ",", "ui", ",", "x", ",", "xi", ",", "\[Lambda]", ",", "k", ",", 
   "\[Delta]", ",", "n"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"eq", ":=", 
  RowBox[{
   RowBox[{"\[Lambda]", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"u", " ", "ui"}], "+", 
      RowBox[{"x", " ", "xi"}]}], ")"}]}], "\[Minus]", 
   RowBox[{"k", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"u", " ", "x"}], "+", 
      RowBox[{"ui", " ", "xi"}]}], ")"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eq", "=", 
   RowBox[{"FullSimplify", "@", 
    RowBox[{"Expand", "[", 
     RowBox[{
      RowBox[{"I", " ", "eq"}], "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ui", "->", 
         RowBox[{"I", " ", "ui"}]}], ",", 
        RowBox[{"x", "->", 
         RowBox[{"I", " ", "x"}]}], ",", 
        RowBox[{"xi", "->", 
         RowBox[{"-", " ", "xi"}]}]}], "}"}]}], "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.995631786824465*^9, 3.99563179440559*^9}, {
   3.995632195343092*^9, 3.9956322196281223`*^9}, {3.995632306710037*^9, 

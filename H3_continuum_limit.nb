12b58357112f"],

Cell[CellGroupData[{

Cell["\<\
This method produces a full zero-curvature hierarchy given a collection of \
Lax matrices. Note that it skips what we know to be trivial equations from \
theory.\
\>", "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{{3.994220986642479*^9, 3.9942210122811737`*^9}, {
   3.9942214568902855`*^9, 3.994221468642479*^9}, 3.994222414181839*^9, 
   3.99475412748942*^9, 3.9947557296562176`*^9, {3.9947560609495964`*^9, 
   3.9947560679098434`*^9}, 3.9947561055637913`*^9, 3.99475617545998*^9, {
   3.994756454278475*^9, 3.994756467894541*^9}, {3.995607682252205*^9, 
   3.995607701115225*^9}},ExpressionUUID->"4724f59f-101f-8345-9a26-\
f7290bbf6842"],

Cell[BoxData[
 RowBox[{
  RowBox[{"laxHierarchy", "[", 
   RowBox[{"laxMatrices_", ",", "maxOrder_Integer"}], "]"}], ":=", 
  RowBox[{"Association", "@", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"n", "->", 
      RowBox[{"Map", "[", 
       RowBox[{"Together", ",", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"laxMatrices", "[", "1", "]"}], ",", 
           RowBox[{"t", "[", "n", "]"}]}], "]"}], "-", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"laxMatrices", "[", "n", "]"}], ",", 
           RowBox[{"t", "[", "1", "]"}]}], "]"}], "+", 
         RowBox[{
          RowBox[{"laxMatrices", "[", "1", "]"}], ".", 
          RowBox[{"laxMatrices", "[", "n", "]"}]}], "-", 
         RowBox[{
          RowBox[{"laxMatrices", "[", "n", "]"}], ".", 
          RowBox[{"laxMatrices", "[", "1", "]"}]}]}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "3", ",", "maxOrder", ",", "2"}], "}"}]}], 
    "]"}]}]}]], "Input",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{{3.9942208087644634`*^9, 3.994220889777664*^9}, {
   3.994220939067091*^9, 3.9942209759221306`*^9}, {3.9942210487655163`*^9, 
   3.9942210489244385`*^9}, {3.994221129362673*^9, 3.9942211293946457`*^9}, {
   3.9942211756249847`*^9, 3.9942212239091263`*^9}, {3.994221423827196*^9, 
   3.9942214527638493`*^9}, 3.994222414181839*^9, {3.994499377288233*^9, 
   3.9944993779490013`*^9}, 3.99475412748942*^9, 3.9947557296562176`*^9, {
   3.9947560609495964`*^9, 3.9947560679098434`*^9}, 3.9947561055637913`*^9, 
   3.99475617545998*^9, {3.994756454278475*^9, 3.994756467894541*^9}, {
   3.9956130732949753`*^9, 3.995613076318552*^9}, {3.9956264052633*^9, 
   3.9956264059429436`*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"a0b90807-a5b7-7949-abae-cff77687d15a"]

 CellLabel->"In[19]:=",ExpressionUUID->"106801fd-be34-864c-8a34-f4e32a5ac00e"]
}, Open  ]],

Cell["\<\
Set the substitution rules for the lattice parameters. The flow of the code \
is the following:
Substitute the explicit expression of the parameters containing \[Lambda] -> \
Expand in \[Lambda]: explicit expression of parameters containing k only \
appear -> make the parameters containing k implicit.\
\>", "Text",
 CellChangeTimes->{{3.9956242529426556`*^9, 3.995624265306324*^9}, {
  3.9956243766187286`*^9, 3.9956243768406544`*^9}, {3.995624462783552*^9, 
  3.9956246005861607`*^9}},ExpressionUUID->"d53f5f49-c4ee-424e-a2c4-\
a48585b4d02f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"latticeParametersSubs", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "->", 
      RowBox[{"Sinh", "[", 
       RowBox[{"2", 
        SuperscriptBox["\[Lambda]", "2"]}], "]"}]}], "\[IndentingNewLine]", ",", 
     RowBox[{"r", "->", 
      RowBox[{"Sinh", "[", 
       RowBox[{
        RowBox[{"2", 
         SuperscriptBox["\[Lambda]", "2"]}], "-", 
        RowBox[{"2", 
         SuperscriptBox["k", "2"]}]}], "]"}]}], "\[IndentingNewLine]", ",", 
     RowBox[{
      RowBox[{"Sinh", "[", 
       RowBox[{"2", 
        SuperscriptBox["k", "2"]}], "]"}], "->", "b"}], "\[IndentingNewLine]",
      ",", 
     RowBox[{
      RowBox[{"Cosh", "[", 
       RowBox[{"2", 
        SuperscriptBox["k", "2"]}], "]"}], "->", "B"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9956242777904663`*^9, 3.9956242853359737`*^9}, {
  3.9956243487419586`*^9, 3.9956243864244213`*^9}, {3.995624668946209*^9, 
  3.99562467102586*^9}, {3.9956318199032555`*^9, 3.9956318815699615`*^9}, {
  3.995632309631075*^9, 3.995632323501356*^9}},
 CellLabel->"In[22]:=",ExpressionUUID->"f682cf9e-bbcf-6845-88ad-6403cae5ed5a"],

Cell[TextData[{
 "This cell is used to make the body of this notebook compatible for all ABS \
equation. \nIf the lattice parameters don\[CloseCurlyQuote]t live on a \
particular spectral curve, set to default\nSimplifier = Together[#] &;\n\
Otherwise, specify the spectral curve function and use\nSimplifier = \
curveReduce[#, b, B, spectralCurve];\nwhere \
(b,B)=(F(k),F\[CloseCurlyQuote](k)). See ",
 ButtonBox["the definition of curveReduce",
  BaseStyle->"Hyperlink",
  ButtonData->"CurveReduce"],
 "."
}], "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{{3.9956235650188847`*^9, 3.9956236106199074`*^9}, {
  3.995623642293688*^9, 3.995623658985386*^9}, {3.99562371000206*^9, 
  3.9956238117302628`*^9}, {3.9956238533192635`*^9, 
  3.9956238773997993`*^9}},ExpressionUUID->"9b784d79-2cea-f746-ab36-\
c23702f3d87c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Simplifier", "=", 
   RowBox[{
    RowBox[{"Together", "[", "#", "]"}], "&"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"spectralCurve", "[", 
      RowBox[{"x_", ",", "X_"}], "]"}], ":=", 
     RowBox[{
      SuperscriptBox["X", "2"], "-", 
      SuperscriptBox["x", "2"], "-", "1"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"Simplifier", "=", 
     RowBox[{
      RowBox[{"curveReduce", "[", 
       RowBox[{"#", ",", "b", ",", "B", ",", "spectralCurve"}], "]"}], 
      "&"}]}], ";"}], "*)"}]}]}], "Input",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},

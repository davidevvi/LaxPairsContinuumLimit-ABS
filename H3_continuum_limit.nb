   3.9956246980189304`*^9},ExpressionUUID->"a2780465-4d6e-b54b-9bbf-\
6d45935440ea"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Expands", " ", "parameters", " ", "containing", " ", "\[Lambda]"}], ",", 
    " ", 
    RowBox[{
     RowBox[{"+", "1"}], " ", "needed", " ", "to", " ", "have", " ", "all", " ",
      "terms", " ", "at", " ", "the", " ", "target", " ", "order"}]}], "*)"}],
   "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"LExp", "=", 
     RowBox[{"Normal", "@", 
      RowBox[{"Series", "[", 
       RowBox[{
        RowBox[{"L", "/.", "latticeParametersSubs"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Lambda]", ",", "0", ",", 
          RowBox[{"maxOrder", "+", "1"}]}], "}"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Substitute", " ", "back", " ", "explicit", " ", "expression", " ", "of", 
     " ", "parameters", " ", "containing", " ", "k", " ", "and", " ", 
     "simplify"}], "*)"}], 
   RowBox[{
    RowBox[{"LExp", "=", 
     RowBox[{"Simplifier", "[", 
      RowBox[{"LExp", "/.", "latticeParametersSubs"}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.995608364736183*^9, 3.9956083820852585`*^9}, {
   3.9956084184863586`*^9, 3.9956084587323303`*^9}, {3.9956085271027813`*^9, 

Cell[CellGroupData[{

Cell["Miwa Expansion", "Section",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{{3.9947540582859*^9, 3.9947540874069977`*^9}, 
   3.9947557296562176`*^9, {3.9947559982728233`*^9, 3.9947560050469437`*^9}, {
   3.9947560609495964`*^9, 3.9947560679098434`*^9}, 3.9947561167840176`*^9, {
   3.994756442719431*^9, 3.99475646788702*^9}, 
   3.9978721603101864`*^9},ExpressionUUID->"da88d9b7-22ff-894b-84f0-\
4ed6343dd256"],

Cell[CellGroupData[{

Cell["\<\
Let' s first define the Miwa shift. They act on variables of the form \
t[1],t[2]... and depend on an arbitrary scaling c. The inverse shift is \
obtained by passing -\[Lambda] in the argument.\
\>", "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{{3.9932017589159527`*^9, 3.993201820929241*^9}, {
   3.9932019881143093`*^9, 3.9932020162540646`*^9}, {3.9932020465283756`*^9, 
   3.9932020601903687`*^9}, 3.993203166911236*^9, 3.9947540874069977`*^9, 
   3.9947557296562176`*^9, {3.9947559982728233`*^9, 3.9947560050469437`*^9}, {
   3.9947560609495964`*^9, 3.9947560679098434`*^9}, 3.9947561167840176`*^9, {
   3.994756442719431*^9, 
   3.99475646788702*^9}},ExpressionUUID->"dc7300ff-5f4c-ff4a-a320-\
55b813603ccb"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"miwaShift", "[", 
    RowBox[{"\[Lambda]_", ",", 
     RowBox[{"maxOrder_Integer", "?", "NonNegative"}]}], "]"}], ":=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"t", "[", "j", "]"}], "->", 
      RowBox[{
       RowBox[{"t", "[", "j", "]"}], "-", " ", 
       RowBox[{"c", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"-", "\[Lambda]"}], ")"}], "^", "j"}], "/", "j"}]}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", 
       RowBox[{"maxOrder", "+", "1"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{{3.9931913378306885`*^9, 3.9931913378306885`*^9}, {
   3.993201824018076*^9, 3.9932019708380585`*^9}, {3.9932020631209755`*^9, 
   3.99320206676462*^9}, {3.9932023716828175`*^9, 3.993202374232155*^9}, 
   3.993203166911236*^9, 3.9947540874069977`*^9, 3.9947557296562176`*^9, {
   3.9947559982728233`*^9, 3.9947560050469437`*^9}, {3.9947560609495964`*^9, 
   3.9947560679098434`*^9}, 3.9947561167840176`*^9, {3.994756442719431*^9, 
   3.994756467894541*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"226ff30d-d1bf-324c-9238-84757a4536a0"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Now define the series expansion for matrices and a function that extract \
the coefficients  of the series. Take advantage of the fact that we\
\[CloseCurlyQuote]re working in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["sl", "2"], TraditionalForm]],ExpressionUUID->
  "0a9f799f-febf-0846-9070-cc3197dfde2a"],
 " to optimize slightly the expansion. "
}], "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{{3.9932022692367477`*^9, 3.9932023670027294`*^9}, 
   3.993203166911236*^9, {3.9932050224225082`*^9, 3.993205066136898*^9}, 
   3.993205210238489*^9, 3.9947540874069977`*^9, 3.9947557296562176`*^9, {
   3.9947559982728233`*^9, 3.9947560050469437`*^9}, {3.9947560609495964`*^9, 
   3.9947560679098434`*^9}, 3.9947561167840176`*^9, {3.994756442719431*^9, 
   3.994756467894541*^9}},ExpressionUUID->"89d0ad37-e622-9946-aa34-\
550dbe8cffbf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Entrywise", " ", "truncated", " ", "matrix", " ", "series"}], 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"matrixSeries", "[", 
     RowBox[{
      RowBox[{"matrix_", "?", "MatrixQ"}], ",", "\[Lambda]_", ",", 
      RowBox[{"maxOrder_Integer", "?", "NonNegative"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"m11", ",", "m12", ",", "m21"}], "}"}], "\[IndentingNewLine]", 
      ",", " ", 
      RowBox[{
       RowBox[{"m11", "=", 
        RowBox[{"Normal", "@", 
         RowBox[{"Series", "[", 
          RowBox[{
           RowBox[{"matrix", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"\[Lambda]", ",", "0", ",", "maxOrder"}], "}"}]}], 
          "]"}]}]}], "\[IndentingNewLine]", ";", " ", 
       RowBox[{"m12", "=", 
        RowBox[{"Normal", "@", 
         RowBox[{"Series", "[", 
          RowBox[{
           RowBox[{"matrix", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "2"}], "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"\[Lambda]", ",", "0", ",", "maxOrder"}], "}"}]}], 
          "]"}]}]}], "\[IndentingNewLine]", ";", " ", 
       RowBox[{"m21", "=", 
        RowBox[{"Normal", "@", 
         RowBox[{"Series", "[", 
          RowBox[{
           RowBox[{"matrix", "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", "1"}], "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"\[Lambda]", ",", "0", ",", "maxOrder"}], "}"}]}], 
          "]"}]}]}], "\[IndentingNewLine]", ";", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"m11", ",", "m12"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"m21", ",", 
           RowBox[{"-", "m11"}]}], "}"}]}], "}"}]}]}], "\[IndentingNewLine]", 
     "]"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Entrywise", " ", "coefficient", " ", "extraction"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"matrixCoefficient", "[", 
     RowBox[{
      RowBox[{"matrix_", "?", "MatrixQ"}], ",", "\[Lambda]_", ",", 
      RowBox[{"n_Integer", "?", "NonNegative"}]}], "]"}], ":=", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Coefficient", "[", 
        RowBox[{"#", ",", "\[Lambda]", ",", "n"}], "]"}], "&"}], ",", 
      "matrix", ",", 
      RowBox[{"{", "2", "}"}]}], "]"}]}], "\[IndentingNewLine]"}]}]], "Input",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{{3.993202378833288*^9, 3.9932023792482452`*^9}, {
   3.9932024103874855`*^9, 3.993202456839861*^9}, {3.993202489527996*^9, 
   3.9932025201330395`*^9}, {3.993202558519312*^9, 3.993202619115692*^9}, 
   3.993203166911236*^9, {3.9932049758854427`*^9, 3.993205015401348*^9}, 
   3.99320515435878*^9, {3.9932051931182423`*^9, 3.99320520340963*^9}, 
   3.994754087409025*^9, 3.9947557296562176`*^9, {3.9947559982728233`*^9, 
   3.9947560050469437`*^9}, {3.9947560609495964`*^9, 3.9947560679098434`*^9}, 
   3.9947561167840176`*^9, {3.994756442719431*^9, 3.994756467894541*^9}, 
   3.9956126590387287`*^9},
 CellLabel->"In[2]:=",ExpressionUUID->"33a79e38-9c2b-c34a-96c6-703b050b5e42"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Create the backshifted Maurer - Cartan form and expand. We are working with \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox["PGL", "2"], TraditionalForm]],ExpressionUUID->
  "7a470475-4626-d744-adad-a7d25318f967"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["pgl", "2"], TraditionalForm]],ExpressionUUID->
  "08bbbd95-2fc0-974c-b126-a01a2fd03af7"],
 " which are isomorphic to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["SL", "2"], TraditionalForm]],ExpressionUUID->
  "84934736-a542-d142-8e21-6e7bf67ab4ef"],
 " and its Lie algebra. This isomorphism is obtained by dividing a \
representative with the square root of the determinant at the level of the \
group, which corresponds to removing ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "2"], TraditionalForm]],ExpressionUUID->
  "722779b4-7df5-ca4c-adfc-23e52897aefd"],
 " the trace of the Maurer-Cartan form at the representative at the level of \
the algebra. Since the square root in the denominator makes computations \
longer, we compute the Maurer-Cartan form for a polynomial matrix and then \
remove half trace."
}], "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{{3.9932026404749565`*^9, 3.9932026613353043`*^9}, {
   3.993202714582062*^9, 3.9932028777713127`*^9}, {3.9932029308944054`*^9, 
   3.993202969601942*^9}, 3.993203166911236*^9, 3.994754087409025*^9, 
   3.9947557296562176`*^9, {3.9947559982728233`*^9, 3.9947560050469437`*^9}, {
   3.9947560609495964`*^9, 3.9947560679098434`*^9}, 3.9947561167840176`*^9, {
   3.994756442719431*^9, 
   3.994756467894541*^9}},ExpressionUUID->"34a3626b-9717-d74b-ac4d-\
82557c2b53cf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"generatingObject", "[", 
   RowBox[{
    RowBox[{"L_", "?", "MatrixQ"}], ",", "\[Lambda]_", ",", 
    RowBox[{"maxOrder_Integer", "?", "NonNegative"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"maurerCartan", ",", "backShifted"}], "}"}], 
    "\[IndentingNewLine]", ",", 
    RowBox[{
     RowBox[{"maurerCartan", "=", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{"L", ",", "\[Lambda]"}], "]"}], ".", 
       RowBox[{"Inverse", "[", "L", "]"}]}]}], "\[IndentingNewLine]", ";", 
     RowBox[{"backShifted", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"maurerCartan", "-", 
         RowBox[{
          FractionBox["1", "2"], 
          RowBox[{"Tr", "[", "maurerCartan", "]"}], 
          RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], ")"}], "/.", 
       RowBox[{"miwaShift", "[", 
        RowBox[{
         RowBox[{"-", "\[Lambda]"}], ",", "maxOrder"}], "]"}]}]}], 
     "\[IndentingNewLine]", ";", 
     RowBox[{"matrixSeries", "[", 
      RowBox[{"backShifted", ",", "\[Lambda]", ",", "maxOrder"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{
  3.9931914226821976`*^9, 3.9931914555307865`*^9, {3.9931934088290825`*^9, 
   3.993193413486479*^9}, 3.993193538258848*^9, {3.9931992282017384`*^9, 
   3.993199287411171*^9}, {3.993199625154146*^9, 3.993199627109026*^9}, {
   3.993202665118458*^9, 3.993202671199768*^9}, {3.9932029784931717`*^9, 
   3.9932030946133347`*^9}, 3.993203166911236*^9, 3.994754087409025*^9, 
   3.9947557296562176`*^9, {3.9947559982728233`*^9, 3.9947560050469437`*^9}, {
   3.9947560609495964`*^9, 3.9947560679098434`*^9}, 3.9947561167840176`*^9, {
   3.994756442726469*^9, 3.994756467894541*^9}, {3.995609967074995*^9, 
   3.995609978243635*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"3df77ee7-b3f0-f84c-a9f6-c42c76eeb04e"]
}, Open  ]],

Cell[TextData[{
 "Finally we extract the continuous lax matrices from the expansion of the \
generating form . The normal coefficient extraction would put ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Us", "[", "0", "]"}], "=", 
    SuperscriptBox["U", 
     RowBox[{"(", "1", ")"}]]}], TraditionalForm]],ExpressionUUID->
  "63325e44-369f-1542-9581-bfad3ab44fae"],
 ", which is a bit annoying to work with. KeyMap fix that."
}], "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{{3.993203109823984*^9, 3.9932031314242554`*^9}, 
   3.993203166911236*^9, {3.9932052150352287`*^9, 3.9932052152181168`*^9}, 
   3.994754087409025*^9, 3.9947557296562176`*^9, {3.9947559982728233`*^9, 
   3.9947560050469437`*^9}, {3.9947560609495964`*^9, 3.9947560679098434`*^9}, 
   3.9947561167840176`*^9, {3.994756442726469*^9, 
   3.994756467894541*^9}},ExpressionUUID->"560da2c7-b27f-f94c-982e-\
bd62eef907ec"],

Cell[BoxData[
 RowBox[{
  RowBox[{"continuousLaxMatrices", "[", 
   RowBox[{
    RowBox[{"GenObj_", "?", "MatrixQ"}], ",", "\[Lambda]_", ",", 
    RowBox[{"maxOrder_Integer", "?", "NonNegative"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "Us", "}"}], "\[IndentingNewLine]", ",", 
    RowBox[{
     RowBox[{"Us", "=", 
      RowBox[{"Association", "@", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"n", "->", 
          RowBox[{"Map", "[", 
           RowBox[{"Together", ",", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"-", "1"}], ")"}], "^", "n"}], "/", "c"}], ")"}], " ", 
             RowBox[{"matrixCoefficient", "[", 
              RowBox[{"GenObj", ",", "\[Lambda]", ",", "n"}], "]"}]}], ",", 
            RowBox[{"{", "2", "}"}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "0", ",", "maxOrder"}], "}"}]}], "]"}]}]}], 
     "\[IndentingNewLine]", ";", 
     RowBox[{"KeyMap", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "+", "1"}], "&"}], ",", "Us"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{{3.9931915105786095`*^9, 3.9931915105786095`*^9}, {
   3.993192237019209*^9, 3.9931922598440247`*^9}, {3.99320313773604*^9, 
   3.993203166911236*^9}, {3.9932051603764324`*^9, 3.9932051849840984`*^9}, {
   3.994506030060074*^9, 3.9945060354681892`*^9}, 3.994754087409025*^9, 
   3.9947557296562176`*^9, {3.9947559982728233`*^9, 3.9947560050469437`*^9}, {
   3.9947560609495964`*^9, 3.9947560679098434`*^9}, 3.9947561167840176`*^9, {
   3.994756442726469*^9, 3.994756467894541*^9}, {3.9956130338062687`*^9, 
   3.9956130616027336`*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"7855e258-1ce9-714e-b5de-701575a23e96"]
}, Closed]],


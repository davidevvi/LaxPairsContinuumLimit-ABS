Cell[TextData[{
 "Turn derivatives into something of the form ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["u", "TI"], 
        RowBox[{"3", 
          SubscriptBox[
           StyleBox["t", "TI"], "1"], 
          SubscriptBox[
           StyleBox["t", "TI"], "2"], "5", 
          SubscriptBox[
           StyleBox["t", "TI"], "3"]}]], TraditionalForm], "errors" -> {}, 
     "input" -> "u_{3t_1 t_2 5t_3}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9df34a3e-457f-b747-a56b-a2ac2fc03ab7"]
}], "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{{3.995607324492235*^9, 
  3.9956073400860767`*^9}},ExpressionUUID->"06f6e26e-ecf2-6644-9f64-\
4ad0e419e311"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Recognises", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"t", "[", "1", "]"}], ",", 
      RowBox[{"t", "[", "2", "]"}], ",", "...", ",", 
      RowBox[{"t", "[", "n", "]"}]}], "}"}]}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"timeArgumentsQ", "[", "args_List", "]"}], ":=", 
     RowBox[{"args", "===", 
      RowBox[{"Array", "[", 
       RowBox[{"t", ",", 
        RowBox[{"Length", "[", "args", "]"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"derivativeLabel", "[", "orders_List", "]"}], ":=", 
     RowBox[{"Row", "[", 
      RowBox[{"MapIndexed", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"#1", "==", "0"}], ",", "Nothing", ",", 
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"#1", "==", "1"}], ",", "Nothing", ",", "#1"}], "]"}],
               ",", 
              RowBox[{"Subscript", "[", 
               RowBox[{"t", ",", 
                RowBox[{"First", "[", "#2", "]"}]}], "]"}]}], "}"}], "]"}]}], 
          "]"}], "&"}], ",", "orders"}], "]"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"compactFieldForm", "[", "expr_", "]"}], ":=", 
     RowBox[{"expr", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"d", ":", 
           RowBox[{"HoldPattern", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Derivative", "[", "orders__", "]"}], "[", "head_", 
              "]"}], "[", "args__", "]"}], "]"}]}], "/;", 
          RowBox[{"timeArgumentsQ", "[", 
           RowBox[{"{", "args", "}"}], "]"}]}], ":>", 
         RowBox[{"Interpretation", "[", 
          RowBox[{
           RowBox[{"Subscript", "[", 
            RowBox[{"head", ",", 
             RowBox[{"derivativeLabel", "[", 
              RowBox[{"{", "orders", "}"}], "]"}]}], "]"}], ",", "d"}], 
          "]"}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"a", ":", 
           RowBox[{"HoldPattern", "[", 
            RowBox[{"head_", "[", "args__", "]"}], "]"}]}], "/;", 
          RowBox[{"timeArgumentsQ", "[", 
           RowBox[{"{", "args", "}"}], "]"}]}], ":>", 
         RowBox[{"Interpretation", "[", 
          RowBox[{"head", ",", "a"}], "]"}]}]}], "}"}]}]}], 
    ";"}]}]}]], "Input",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},

Cell[CellGroupData[{

Cell[" Miwa Expansion", "Section",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{{3.9947540582859*^9, 3.9947540874069977`*^9}, 
   3.9947557296562176`*^9, {3.9947559982728233`*^9, 3.9947560050469437`*^9}, {
   3.9947560609495964`*^9, 3.9947560679098434`*^9}, 3.9947561167840176`*^9, {
   3.994756442719431*^9, 
   3.99475646788702*^9}},ExpressionUUID->"8282d1f6-edaf-784a-8455-\
fb63e42b4e85"],

Cell["\<\
Let' s first define the Miwa shift. They act on variables of the form \
t[1],t[2]... and depend on an arbitrary scaling c. The inverse shift is \
obtained by passing -\[Lambda] in the argument.\
\>", "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{{3.9932017589159527`*^9, 3.993201820929241*^9}, {
   3.9932019881143093`*^9, 3.9932020162540646`*^9}, {3.9932020465283756`*^9, 
   3.9932020601903687`*^9}, 3.993203166911236*^9, 3.9947540874069977`*^9, 
   3.9947557296562176`*^9, {3.9947559982728233`*^9, 3.9947560050469437`*^9}, {
   3.9947560609495964`*^9, 3.9947560679098434`*^9}, 3.9947561167840176`*^9, {
   3.994756442719431*^9, 
   3.99475646788702*^9}},ExpressionUUID->"352fbcf9-4070-9949-a5d0-\
9eb08bb8c88a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"miwaShift", "[", 
    RowBox[{"\[Lambda]_", ",", 
     RowBox[{"maxOrder_Integer", "?", "NonNegative"}]}], "]"}], ":=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"t", "[", "j", "]"}], "->", 
      RowBox[{
       RowBox[{"t", "[", "j", "]"}], "-", " ", 
       RowBox[{"c", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"-", "\[Lambda]"}], ")"}], "^", "j"}], "/", "j"}]}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", 
       RowBox[{"maxOrder", "+", "1"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{{3.9931913378306885`*^9, 3.9931913378306885`*^9}, {
   3.993201824018076*^9, 3.9932019708380585`*^9}, {3.9932020631209755`*^9, 
   3.99320206676462*^9}, {3.9932023716828175`*^9, 3.993202374232155*^9}, 
   3.993203166911236*^9, 3.9947540874069977`*^9, 3.9947557296562176`*^9, {
   3.9947559982728233`*^9, 3.9947560050469437`*^9}, {3.9947560609495964`*^9, 
   3.9947560679098434`*^9}, 3.9947561167840176`*^9, {3.994756442719431*^9, 
   3.994756467894541*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"4f2fc9b0-e940-7c43-95bf-61b30b5bc032"],

Cell[TextData[{
 "Now define the series expansion for matrices and a function that extract \
the coefficients  of the series. Take advantage of the fact that we\
\[CloseCurlyQuote]re working in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["sl", "2"], TraditionalForm]],ExpressionUUID->
  "4f93e98f-3f4c-c740-867d-7d60a766f118"],
 " to optimize slightly the expansion. "
}], "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{{3.9932022692367477`*^9, 3.9932023670027294`*^9}, 
   3.993203166911236*^9, {3.9932050224225082`*^9, 3.993205066136898*^9}, 
   3.993205210238489*^9, 3.9947540874069977`*^9, 3.9947557296562176`*^9, {
   3.9947559982728233`*^9, 3.9947560050469437`*^9}, {3.9947560609495964`*^9, 
   3.9947560679098434`*^9}, 3.9947561167840176`*^9, {3.994756442719431*^9, 
   3.994756467894541*^9}},ExpressionUUID->"2fedadf5-1c10-8b45-a226-\
40c3b0a0055f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Entrywise", " ", "truncated", " ", "matrix", " ", "series"}], 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"matrixSeries", "[", 
     RowBox[{
      RowBox[{"matrix_", "?", "MatrixQ"}], ",", "\[Lambda]_", ",", 
      RowBox[{"maxOrder_Integer", "?", "NonNegative"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"m11", ",", "m12", ",", "m21"}], "}"}], "\[IndentingNewLine]", 
      ",", " ", 
      RowBox[{
       RowBox[{"m11", "=", 
        RowBox[{"Normal", "@", 
         RowBox[{"Series", "[", 
          RowBox[{
           RowBox[{"matrix", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"\[Lambda]", ",", "0", ",", "maxOrder"}], "}"}]}], 
          "]"}]}]}], "\[IndentingNewLine]", ";", " ", 
       RowBox[{"m12", "=", 
        RowBox[{"Normal", "@", 
         RowBox[{"Series", "[", 
          RowBox[{
           RowBox[{"matrix", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "2"}], "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"\[Lambda]", ",", "0", ",", "maxOrder"}], "}"}]}], 
          "]"}]}]}], "\[IndentingNewLine]", ";", " ", 
       RowBox[{"m21", "=", 
        RowBox[{"Normal", "@", 
         RowBox[{"Series", "[", 
          RowBox[{
           RowBox[{"matrix", "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", "1"}], "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"\[Lambda]", ",", "0", ",", "maxOrder"}], "}"}]}], 
          "]"}]}]}], "\[IndentingNewLine]", ";", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"m11", ",", "m12"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"m21", ",", 
           RowBox[{"-", "m11"}]}], "}"}]}], "}"}]}]}], "\[IndentingNewLine]", 
     "]"}]}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Entrywise", " ", "coefficient", " ", "extraction"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"matrixCoefficient", "[", 
     RowBox[{
      RowBox[{"matrix_", "?", "MatrixQ"}], ",", "\[Lambda]_", ",", 
      RowBox[{"n_Integer", "?", "NonNegative"}]}], "]"}], ":=", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Coefficient", "[", 
        RowBox[{"#", ",", "\[Lambda]", ",", "n"}], "]"}], "&"}], ",", 
      "matrix", ",", 
      RowBox[{"{", "2", "}"}]}], "]"}]}], "\[IndentingNewLine]"}]}]], "Input",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{{3.993202378833288*^9, 3.9932023792482452`*^9}, {
   3.9932024103874855`*^9, 3.993202456839861*^9}, {3.993202489527996*^9, 
   3.9932025201330395`*^9}, {3.993202558519312*^9, 3.993202619115692*^9}, 
   3.993203166911236*^9, {3.9932049758854427`*^9, 3.993205015401348*^9}, 
   3.99320515435878*^9, {3.9932051931182423`*^9, 3.99320520340963*^9}, 
   3.994754087409025*^9, 3.9947557296562176`*^9, {3.9947559982728233`*^9, 
   3.9947560050469437`*^9}, {3.9947560609495964`*^9, 3.9947560679098434`*^9}, 
   3.9947561167840176`*^9, {3.994756442719431*^9, 3.994756467894541*^9}, 
   3.9956126590387287`*^9},
 CellLabel->"In[2]:=",ExpressionUUID->"12fecb26-e52b-c148-ad11-1cd459ccd6a9"],

Cell[TextData[{
 "Create the backshifted Maurer - Cartan form and expand. We are working with \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox["PGL", "2"], TraditionalForm]],ExpressionUUID->
  "b6125fb7-beaa-444b-9128-e764174cb78d"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["pgl", "2"], TraditionalForm]],ExpressionUUID->
  "de8f53cb-7078-3248-a821-a4dc73ef74b2"],
 " which are isomorphic to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["SL", "2"], TraditionalForm]],ExpressionUUID->
  "3ec629d7-543d-cb4f-a5b3-aa79088e8728"],
 " and its Lie algebra. This isomorphism is obtained by dividing a \
representative with the square root of the determinant at the level of the \
group, which corresponds to removing ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "2"], TraditionalForm]],ExpressionUUID->
  "ef17c166-566c-6f47-9ded-d6df3022f459"],
 " the trace of the Maurer-Cartan form at the representative at the level of \
the algebra. Since the square root in the denominator makes computations \
longer, we compute the Maurer-Cartan form for a polynomial matrix and then \
remove half trace."
}], "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{{3.9932026404749565`*^9, 3.9932026613353043`*^9}, {
   3.993202714582062*^9, 3.9932028777713127`*^9}, {3.9932029308944054`*^9, 
   3.993202969601942*^9}, 3.993203166911236*^9, 3.994754087409025*^9, 
   3.9947557296562176`*^9, {3.9947559982728233`*^9, 3.9947560050469437`*^9}, {
   3.9947560609495964`*^9, 3.9947560679098434`*^9}, 3.9947561167840176`*^9, {
   3.994756442719431*^9, 
   3.994756467894541*^9}},ExpressionUUID->"8443a5b5-af1f-c84e-a92b-\
ad7e9a12182c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"generatingObject", "[", 
   RowBox[{
    RowBox[{"L_", "?", "MatrixQ"}], ",", "\[Lambda]_", ",", 
    RowBox[{"maxOrder_Integer", "?", "NonNegative"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"maurerCartan", ",", "backShifted"}], "}"}], 
    "\[IndentingNewLine]", ",", 
    RowBox[{
     RowBox[{"maurerCartan", "=", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{"L", ",", "\[Lambda]"}], "]"}], ".", 
       RowBox[{"Inverse", "[", "L", "]"}]}]}], "\[IndentingNewLine]", ";", 
     RowBox[{"backShifted", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"maurerCartan", "-", 
         RowBox[{
          FractionBox["1", "2"], 
          RowBox[{"Tr", "[", "maurerCartan", "]"}], 
          RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], ")"}], "/.", 
       RowBox[{"miwaShift", "[", 
        RowBox[{
         RowBox[{"-", "\[Lambda]"}], ",", "maxOrder"}], "]"}]}]}], 
     "\[IndentingNewLine]", ";", 
     RowBox[{"matrixSeries", "[", 
      RowBox[{"backShifted", ",", "\[Lambda]", ",", "maxOrder"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{
  3.9931914226821976`*^9, 3.9931914555307865`*^9, {3.9931934088290825`*^9, 
   3.993193413486479*^9}, 3.993193538258848*^9, {3.9931992282017384`*^9, 
   3.993199287411171*^9}, {3.993199625154146*^9, 3.993199627109026*^9}, {
   3.993202665118458*^9, 3.993202671199768*^9}, {3.9932029784931717`*^9, 
   3.9932030946133347`*^9}, 3.993203166911236*^9, 3.994754087409025*^9, 
   3.9947557296562176`*^9, {3.9947559982728233`*^9, 3.9947560050469437`*^9}, {
   3.9947560609495964`*^9, 3.9947560679098434`*^9}, 3.9947561167840176`*^9, {
   3.994756442726469*^9, 3.994756467894541*^9}, {3.995609967074995*^9, 
   3.995609978243635*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"c3e62fcf-5bfd-b441-b215-bde421e58f26"],

Cell[TextData[{
 "Finally we extract the continuous lax matrices from the expansion of the \
generating form . The normal coefficient extraction would put ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Us", "[", "0", "]"}], "=", 
    SuperscriptBox["U", 
     RowBox[{"(", "1", ")"}]]}], TraditionalForm]],ExpressionUUID->
  "17c5a7b0-06a6-cf44-acfe-aa393beee30f"],
 ", which is a bit annoying to work with. KeyMap fix that."
}], "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{{3.993203109823984*^9, 3.9932031314242554`*^9}, 
   3.993203166911236*^9, {3.9932052150352287`*^9, 3.9932052152181168`*^9}, 
   3.994754087409025*^9, 3.9947557296562176`*^9, {3.9947559982728233`*^9, 
   3.9947560050469437`*^9}, {3.9947560609495964`*^9, 3.9947560679098434`*^9}, 
   3.9947561167840176`*^9, {3.994756442726469*^9, 
   3.994756467894541*^9}},ExpressionUUID->"eadea24e-783a-8a4a-934a-\
2afcfa45b1ec"],

Cell[BoxData[
 RowBox[{
  RowBox[{"continuousLaxMatrices", "[", 
   RowBox[{
    RowBox[{"GenObj_", "?", "MatrixQ"}], ",", "\[Lambda]_", ",", 
    RowBox[{"maxOrder_Integer", "?", "NonNegative"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "Us", "}"}], "\[IndentingNewLine]", ",", 
    RowBox[{
     RowBox[{"Us", "=", 
      RowBox[{"Association", "@", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"n", "->", 
          RowBox[{"Map", "[", 
           RowBox[{"Together", ",", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"-", "1"}], ")"}], "^", "n"}], "/", "c"}], ")"}], " ", 
             RowBox[{"matrixCoefficient", "[", 
              RowBox[{"GenObj", ",", "\[Lambda]", ",", "n"}], "]"}]}], ",", 
            RowBox[{"{", "2", "}"}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", "0", ",", "maxOrder"}], "}"}]}], "]"}]}]}], 
     "\[IndentingNewLine]", ";", 
     RowBox[{"KeyMap", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"#", "+", "1"}], "&"}], ",", "Us"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{{3.9931915105786095`*^9, 3.9931915105786095`*^9}, {
   3.993192237019209*^9, 3.9931922598440247`*^9}, {3.99320313773604*^9, 
   3.993203166911236*^9}, {3.9932051603764324`*^9, 3.9932051849840984`*^9}, {
   3.994506030060074*^9, 3.9945060354681892`*^9}, 3.994754087409025*^9, 
   3.9947557296562176`*^9, {3.9947559982728233`*^9, 3.9947560050469437`*^9}, {
   3.9947560609495964`*^9, 3.9947560679098434`*^9}, 3.9947561167840176`*^9, {
   3.994756442726469*^9, 3.994756467894541*^9}, {3.9956130338062687`*^9, 
   3.9956130616027336`*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"efe1c0dd-1935-9448-8a41-16557dc588eb"]
}, Closed]],

Cell[CellGroupData[{

Cell["General functions", "Section",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{{3.994754104526085*^9, 3.99475412748942*^9}, 
   3.9947557296562176`*^9, {3.9947560609495964`*^9, 3.9947560679098434`*^9}, 
   3.9947561055637913`*^9, 3.99475617545998*^9, {3.994756454278475*^9, 
   3.994756467894541*^9}, {3.995607729927557*^9, 
   3.9956077329798965`*^9}},ExpressionUUID->"63f430d2-832b-454f-ae78-\
d9c544ff83c6"],

Cell["\<\
This method produces a full zero-curvature hierarchy given a collection of \
Lax matrices. Note that it skips what we know to be trivial equations from \
theory.\
\>", "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{{3.994220986642479*^9, 3.9942210122811737`*^9}, {
   3.9942214568902855`*^9, 3.994221468642479*^9}, 3.994222414181839*^9, 
   3.99475412748942*^9, 3.9947557296562176`*^9, {3.9947560609495964`*^9, 
   3.9947560679098434`*^9}, 3.9947561055637913`*^9, 3.99475617545998*^9, {
   3.994756454278475*^9, 3.994756467894541*^9}, {3.995607682252205*^9, 
   3.995607701115225*^9}},ExpressionUUID->"c11b83c5-eea4-b543-a8aa-\
7ae8f3343f81"],

Cell[BoxData[
 RowBox[{
  RowBox[{"laxHierarchy", "[", 
   RowBox[{"laxMatrices_", ",", "maxOrder_Integer"}], "]"}], ":=", 
  RowBox[{"Association", "@", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"n", "->", 
      RowBox[{"Map", "[", 
       RowBox[{"Together", ",", 
        RowBox[{
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"laxMatrices", "[", "1", "]"}], ",", 
           RowBox[{"t", "[", "n", "]"}]}], "]"}], "-", 
         RowBox[{"D", "[", 
          RowBox[{
           RowBox[{"laxMatrices", "[", "n", "]"}], ",", 
           RowBox[{"t", "[", "1", "]"}]}], "]"}], "+", 
         RowBox[{
          RowBox[{"laxMatrices", "[", "1", "]"}], ".", 
          RowBox[{"laxMatrices", "[", "n", "]"}]}], "-", 
         RowBox[{
          RowBox[{"laxMatrices", "[", "n", "]"}], ".", 
          RowBox[{"laxMatrices", "[", "1", "]"}]}]}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "3", ",", "maxOrder", ",", "2"}], "}"}]}], 
    "]"}]}]}]], "Input",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{{3.9942208087644634`*^9, 3.994220889777664*^9}, {
   3.994220939067091*^9, 3.9942209759221306`*^9}, {3.9942210487655163`*^9, 
   3.9942210489244385`*^9}, {3.994221129362673*^9, 3.9942211293946457`*^9}, {
   3.9942211756249847`*^9, 3.9942212239091263`*^9}, {3.994221423827196*^9, 
   3.9942214527638493`*^9}, 3.994222414181839*^9, {3.994499377288233*^9, 
   3.9944993779490013`*^9}, 3.99475412748942*^9, 3.9947557296562176`*^9, {
   3.9947560609495964`*^9, 3.9947560679098434`*^9}, 3.9947561055637913`*^9, 
   3.99475617545998*^9, {3.994756454278475*^9, 3.994756467894541*^9}, {
   3.9956130732949753`*^9, 3.995613076318552*^9}, {3.9956264052633*^9, 
   3.9956264059429436`*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"4bb08750-9dc9-c442-81db-92a4c50ac125"],

Cell["\<\
It is also useful to have a quick way to compute a single \
zero-curvature-equation between two continuous matrices, have to be named \
Us[i] .\
\>", "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},

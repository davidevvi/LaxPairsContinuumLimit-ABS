Cell[BoxData[
 RowBox[{
  RowBox[{"eq", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"u", " ", "ui"}], " ", "+", 
       RowBox[{"x", " ", "xi"}]}], ")"}], "a"}], "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"ui", " ", "xi"}], "+", 
       RowBox[{"u", " ", "x"}]}], " ", ")"}], "b"}], "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"u", " ", "xi"}], " ", "+", " ", 
       RowBox[{"ui", " ", "x"}]}], ")"}], "r"}], "-", " ", 
    RowBox[{
     SuperscriptBox["\[Delta]", "2"], " ", "a", " ", "b", " ", "r"}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.995631786824465*^9, 3.99563179440559*^9}, {
  3.995632195343092*^9, 3.9956322196281223`*^9}, {3.995632306710037*^9, 

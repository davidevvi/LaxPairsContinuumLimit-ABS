Cell[TextData[{
 "Lattice parameters live on an algebraic curve  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
            SuperscriptBox[
             StyleBox["x", "TI"], "\[Prime]"], ")"}], "2"], "\[LongEqual]", 
         StyleBox["r", "TI"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}]}], TraditionalForm], "errors" -> {}, 
     "input" -> "(x')^2=r(x)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0ba0ca70-eb8a-9d40-8146-88ab7ee45afe"],
 ". The following function impose this constraint (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["X", "TI"], "\[LongEqual]", 
         SuperscriptBox[
          StyleBox["x", "TI"], "\[Prime]"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "X=x'", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4513dbd7-c87b-b64a-89fd-6580ffebbe8c"],
 "). "
}], "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{{3.9956078011880074`*^9, 3.9956080014249973`*^9}, 
   3.9956122220422344`*^9},ExpressionUUID->"330d7924-9fe2-004c-ba67-\
cc4e90291e8e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Reduce", " ", "a", " ", "matrix", " ", "entrywise"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"curveReduce", "[", 
      RowBox[{
       RowBox[{"m_", "?", "MatrixQ"}], ",", "x_", ",", "X_", ",", "curve_"}], 
      "]"}], ":=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"curveReduce", "[", 
         RowBox[{"#", ",", "x", ",", "X", ",", "curve"}], "]"}], "&"}], ",", 
       "m", ",", 
       RowBox[{"{", "2", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"curveReduce", "[", 
     RowBox[{"expr_", ",", " ", "x_", ",", "X_", ",", "curve_"}], "]"}], ":=", 
    RowBox[{"Module", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"e", "=", 
         RowBox[{"Together", "[", "expr", "]"}]}], ",", 
        RowBox[{"\[CapitalGamma]", "=", 
         RowBox[{"curve", "[", 
          RowBox[{"x", ",", "X"}], "]"}]}], ",", "numReduced", ",", " ", 
        "denReduced"}], "}"}], "\[IndentingNewLine]", ",", 
      RowBox[{
       RowBox[{"numReduced", "=", 
        RowBox[{"Collect", "[", 
         RowBox[{
          RowBox[{"PolynomialRemainder", "[", 
           RowBox[{
            RowBox[{"Expand", "@", 
             RowBox[{"Numerator", "[", "e", "]"}]}], ",", "\[CapitalGamma]", ",",
             "X"}], "]"}], ",", "X", ",", "Expand"}], "]"}]}], 
       "\[IndentingNewLine]", ";", 
       RowBox[{"denReduced", "=", 
        RowBox[{"Collect", "[", 
         RowBox[{
          RowBox[{"PolynomialRemainder", "[", 
           RowBox[{
            RowBox[{"Expand", "@", 
             RowBox[{"Denominator", "[", "e", "]"}]}], ",", "\[CapitalGamma]",
             ",", "X"}], "]"}], ",", "X", ",", "Expand"}], "]"}]}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Return", " ", "the", " ", "result"}], "*)"}], 
       "\[IndentingNewLine]", ";", 
       RowBox[{"Collect", "[", 
        RowBox[{
         RowBox[{"Expand", "[", 
          RowBox[{"numReduced", "/", "denReduced"}], "]"}], ",", "X", ",", 
         RowBox[{"Cancel", "@*", "Together"}]}], "]"}]}]}], 
     "\[IndentingNewLine]", "]"}]}]}]}]], "Input",
 CellChangeTimes->{
  3.9956080456478233`*^9, {3.9956090760257053`*^9, 3.9956090845438957`*^9}, {
   3.9956091621282597`*^9, 3.995609299989279*^9}, {3.995609334024679*^9, 
   3.995609346167795*^9}, {3.99560950377026*^9, 3.9956095849791374`*^9}, {
   3.995609651331028*^9, 3.995609795747345*^9}, {3.9956104045106354`*^9, 
   3.995610405223583*^9}, {3.9956104687128773`*^9, 3.995610475187994*^9}, {
   3.995611985399025*^9, 3.995611988069273*^9}, {3.9956122127848034`*^9, 
   3.995612234429409*^9}},
 CellTags->"CurveReduce",
 CellLabel->"In[8]:=",ExpressionUUID->"59cb7c4e-8c78-9a40-89ed-bd78fcea8103"],

Cell[TextData[{
 "This module handles the tedious part of the computations. Once the \
continuum limit is done, it substitute into each Lax matrix the lower flows, \
so that ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["U", 
    RowBox[{"(", "n", ")"}]], TraditionalForm]],ExpressionUUID->
  "403c74e2-8e70-8c4e-a1a6-2c23aff8d0f2"],
 " depends on derivatives wrt ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["t", "n"], TraditionalForm]],ExpressionUUID->
  "7e18003b-d059-e84e-9596-fc7ed9934ee6"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["t", "1"], TraditionalForm]],ExpressionUUID->
  "984ea493-2b7f-d044-8a29-efff9b1938dd"],
 " only. Since it compute the zero curvature equations and the hierarchy of \
PDEs, it return these two objects too. It also return Residual, which is used \
to check that there are no mistakes: if everything is fine, it should be 0."
}], "Text",
 CellChangeTimes->{{3.9956259545153065`*^9, 3.995626001567465*^9}, {
  3.9956260455991096`*^9, 3.9956261327852554`*^9}, {3.9956294638604507`*^9, 
  3.9956294970085316`*^9}},ExpressionUUID->"0e520de3-1a7c-2a45-b8c3-\
93634df3ca65"],

Cell[BoxData[
 RowBox[{
  RowBox[{"replaceLowerFlows", "[", 
   RowBox[{
   "laxMatrices_Association", ",", "maxOrder_Integer", ",", "field_", ",", 
    "spectralParameters_List", ",", "Simplifier_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"u", "=", "field"}], ",", 
      RowBox[{"ts", "=", 
       RowBox[{"t", "/@", 
        RowBox[{"Range", "[", 
         RowBox[{"1", ",", "maxOrder"}], "]"}]}]}], ",", "makeRules", ",", 
      RowBox[{"rules", "=", 
       RowBox[{"{", "}"}]}], ",", 
      RowBox[{"laxMatricesReduced", "=", 
       RowBox[{"<|", 
        RowBox[{"1", "->", 
         RowBox[{"laxMatrices", "[", "1", "]"}]}], "|>"}]}], ",", 
      RowBox[{"zccs", "=", 
       RowBox[{"<|", "|>"}]}], ",", 
      RowBox[{"pdes", "=", 
       RowBox[{"<|", "|>"}]}], ",", "eqs", ",", "dn", ",", "F"}], "}"}], 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
      "Given", " ", "an", " ", "integer", " ", "p", " ", "and", " ", "a", " ",
        "function", " ", "rhs", " ", "of", " ", "the", " ", "fields"}], ",", 
      " ", 
      RowBox[{
       RowBox[{
       "compute", " ", "all", " ", "differential", " ", "consequence", " ", 
        "of", " ", "u_t", "_p"}], "=", 
       RowBox[{"rhs", "[", "u", "]"}]}]}], "*)"}], "\[IndentingNewLine]", ",", 
    RowBox[{
     RowBox[{
      RowBox[{"makeRules", "[", 
       RowBox[{"p_", ",", "rhs_"}], "]"}], ":=", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Derivative", "[", "d__", "]"}], "[", "u", "]"}], "[", 
         RowBox[{"Sequence", "@@", "ts"}], "]"}], "/;", 
        RowBox[{
         RowBox[{
          RowBox[{"{", "d", "}"}], "[", 
          RowBox[{"[", "p", "]"}], "]"}], ">=", "1"}]}], ":>", 
       RowBox[{"D", "[", 
        RowBox[{"rhs", ",", 
         RowBox[{"Sequence", "@@", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"ts", ",", 
             RowBox[{"ReplacePart", "[", 
              RowBox[{
               RowBox[{"{", "d", "}"}], ",", 
               RowBox[{"p", "->", 
                RowBox[{
                 RowBox[{
                  RowBox[{"{", "d", "}"}], "[", 
                  RowBox[{"[", "p", "]"}], "]"}], "-", "1"}]}]}], "]"}]}], 
            "}"}], "]"}]}]}], "]"}]}]}], "\[IndentingNewLine]", 
     "\[IndentingNewLine]", ";", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"laxMatricesReduced", "[", "n", "]"}], "=", 
          RowBox[{"Simplifier", "[", 
           RowBox[{
            RowBox[{"laxMatrices", "[", "n", "]"}], "//.", "rules"}], "]"}]}],
          "\[IndentingNewLine]", ";", 
         RowBox[{
          RowBox[{"zccs", "[", "n", "]"}], "=", 
          RowBox[{"Simplifier", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"D", "[", 
               RowBox[{
                RowBox[{"laxMatricesReduced", "[", "1", "]"}], ",", 
                RowBox[{"t", "[", "n", "]"}]}], "]"}], "-", 
              RowBox[{"D", "[", 
               RowBox[{
                RowBox[{"laxMatricesReduced", "[", "n", "]"}], ",", 
                RowBox[{"t", "[", "1", "]"}]}], "]"}], "+", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"laxMatricesReduced", "[", "1", "]"}], ".", 
                 RowBox[{"laxMatricesReduced", "[", "n", "]"}]}], "-", 
                RowBox[{
                 RowBox[{"laxMatricesReduced", "[", "n", "]"}], ".", 
                 RowBox[{"laxMatricesReduced", "[", "1", "]"}]}]}], ")"}]}], 
             ")"}], "//.", "rules"}], "\[IndentingNewLine]", "]"}]}], 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "Turn", " ", "each", " ", "coefficient", " ", "of", " ", "the", " ",
            "spectral", " ", "parameter", " ", "into", " ", "an", " ", 
           "equation"}], "*)"}], "\[IndentingNewLine]", ";", 
         RowBox[{"eqs", "=", 
          RowBox[{"DeleteCases", "[", 
           RowBox[{
            RowBox[{"Flatten", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"CoefficientList", "[", 
                RowBox[{
                 RowBox[{"Simplifier", "@", 
                  RowBox[{"Numerator", "@", 
                   RowBox[{"Together", "[", "#", "]"}]}]}], ",", 
                 "spectralParameters"}], "]"}], "&"}], "/@", 
              RowBox[{"Flatten", "[", 
               RowBox[{"zccs", "[", "n", "]"}], "]"}]}], "]"}], ",", "0"}], 
           "]"}]}], "\[IndentingNewLine]", ";", " ", 
         RowBox[{"dn", "=", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"u", "@@", 
             RowBox[{"Sequence", "[", "ts", "]"}]}], ",", 
            RowBox[{"t", "[", "n", "]"}]}], "]"}]}], "\[IndentingNewLine]", ";",
          " ", 
         RowBox[{"Print", "[", "dn", "]"}], "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "Pick", " ", "an", " ", "equation", " ", "containing", " ", "dn", " ",
            "and", " ", "solve", " ", "it", " ", "for", " ", 
           RowBox[{"dn", ".", " ", "Residual"}], " ", "is", " ", "used", " ", 
           "to", " ", "check", " ", "that", " ", "it", " ", 
           RowBox[{"doesn", "'"}], "t", " ", "matter", " ", "which", " ", 
           "equation", " ", "we", " ", "take"}], "*)"}], 
         "\[IndentingNewLine]", ";", 
         RowBox[{"F", "=", 
          RowBox[{"Simplifier", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"dn", "/.", " ", 
              RowBox[{"First", "@", 
               RowBox[{"Solve", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"First", "[", 
                   RowBox[{"Select", "[", 
                    RowBox[{"eqs", ",", 
                    RowBox[{
                    RowBox[{"!", 
                    RowBox[{"FreeQ", "[", 
                    RowBox[{"#", ",", "dn"}], "]"}]}], "&"}]}], "]"}], "]"}], 
                  "==", "0"}], ",", "dn"}], "]"}]}]}], ")"}], "//.", 
            "rules"}], "]"}]}], "\[IndentingNewLine]", ";"}], 
        RowBox[{"(*", 
         RowBox[{"F", "=", 
          RowBox[{"Simplifier", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"dn", "/.", " ", 
              RowBox[{"First", "@", 
               RowBox[{"Solve", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"zccs", "[", "n", "]"}], "[", 
                   RowBox[{"[", 
                    RowBox[{"1", ",", "1"}], "]"}], "]"}], "==", "0"}], ",", 
                 "dn"}], "]"}]}]}], ")"}], "//.", "rules"}], "]"}]}], "*)"}], 
        "\[IndentingNewLine]", ";", 
        RowBox[{
         RowBox[{"pdes", "[", "n", "]"}], "=", 
         RowBox[{"dn", "->", "F"}]}], "\[IndentingNewLine]", ";", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"rules", ",", 
          RowBox[{"makeRules", "[", 
           RowBox[{"n", ",", "F"}], "]"}]}], "]"}], "\[IndentingNewLine]", ";", 
        RowBox[{
         RowBox[{"laxMatricesReduced", "[", "n", "]"}], "=", 
         RowBox[{"Simplifier", "[", 
          RowBox[{
           RowBox[{"laxMatrices", "[", "n", "]"}], "//.", "rules"}], 
          "]"}]}]}], "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "3", ",", "maxOrder", ",", "2"}], "}"}]}], 
      "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", ";", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Us\>\"", "->", "laxMatricesReduced"}], ",", 
       RowBox[{"\"\<ZCCs\>\"", "->", "zccs"}], ",", 
       RowBox[{"\"\<PDEs\>\"", "->", "pdes"}], ",", 
       RowBox[{"\"\<Residuals\>\"", "->", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Simplifier", "[", 
            RowBox[{"#", "//.", "rules"}], "]"}], "&"}], "/@", "zccs"}], 
         ")"}]}]}], "|>"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.995626233105526*^9, 3.9956263036997604`*^9}, {
   3.99562638736051*^9, 3.9956264007958584`*^9}, {3.995627129766283*^9, 
   3.995627142966942*^9}, {3.9956271848265705`*^9, 3.9956274841837864`*^9}, {
   3.995627516701357*^9, 3.995627545151108*^9}, {3.9956279383023033`*^9, 
   3.995627974280073*^9}, {3.995628488925291*^9, 3.995628585417923*^9}, {
   3.9956286177958393`*^9, 3.9956286294832935`*^9}, {3.9956286654575615`*^9, 
   3.995628682468195*^9}, {3.9956287337012043`*^9, 3.995628734915737*^9}, {
   3.995628778527857*^9, 3.995628783869236*^9}, {3.995629029505419*^9, 
   3.9956290662747803`*^9}, {3.995629255416603*^9, 3.9956292964585915`*^9}, {
   3.9956293368792305`*^9, 3.9956293421828957`*^9}, {3.995629376521042*^9, 
   3.995629456044052*^9}, {3.9956295062958946`*^9, 3.995629509205124*^9}, {
   3.9956295401586323`*^9, 3.9956296324752274`*^9}, 3.995629669888382*^9, {
   3.995629705522127*^9, 3.995629711850687*^9}, {3.995629865445259*^9, 
   3.995629904072157*^9}, {3.9956300011580334`*^9, 3.995630190883257*^9}, 
   3.9956303346705704`*^9, {3.9956304254459057`*^9, 3.995630452533636*^9}, {
   3.9956309105490704`*^9, 3.99563096968779*^9}, {3.9956310378019238`*^9, 
   3.995631047187065*^9}, {3.995631129357191*^9, 3.995631129520054*^9}, 
   3.9956311735027447`*^9, {3.99563205453578*^9, 3.995632060698992*^9}, {
   3.995632102660757*^9, 3.995632111526264*^9}, {3.9956323647781982`*^9, 
   3.995632364975437*^9}, {3.9956326113087063`*^9, 3.9956326234031277`*^9}, {
   3.9956334733330154`*^9, 3.9956334995874653`*^9}, {3.995633607527088*^9, 
   3.995633607590246*^9}, {3.995634111765177*^9, 3.9956341183475647`*^9}, {
   3.995634187591505*^9, 3.995634189826044*^9}, {3.9956343340919895`*^9, 
   3.995634403068289*^9}, {3.9956345158037624`*^9, 3.995634518888796*^9}, 
   3.995634644138563*^9, {3.99563470340539*^9, 3.995634709849596*^9}, {
   3.995634845913143*^9, 3.9956348818463497`*^9}, 3.9956349132416153`*^9, {
   3.9956354911756306`*^9, 3.995635491440777*^9}},
